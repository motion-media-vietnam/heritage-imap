---
import PrototypeExplorer from '../components/imap/PrototypeExplorer.astro';
import HeritageLauncher from '../components/HeritageLauncher.astro';
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Lora:wght@400;500&display=swap" rel="stylesheet" />
    <title>iMap · Hanoi</title>
    <script is:inline data-presentation-init>
      if (new URLSearchParams(window.location.search).get('presentation') === '1') {
        document.documentElement.dataset.presentation = 'true';
        document.title = 'iMap · Hanoi';
      }
    </script>
  </head>
  <body><main><PrototypeExplorer /></main><HeritageLauncher /></body>
</html>
<style is:global>
  body { margin: 0; }
  :root[data-presentation=true] astro-dev-toolbar { display: none; }
</style>
