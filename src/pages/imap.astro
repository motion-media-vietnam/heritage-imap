---
import IMap from '../components/imap/IMap.astro';
import HeritageLauncher from '../components/HeritageLauncher.astro';
import BrandLogo from '../components/BrandLogo.astro';
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Khám phá các điểm đến Hà Nội qua bản đồ, câu chuyện và thông tin thực tế được tuyển chọn." />
    <title>iMap · Hà Nội — My Hanoi</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Lora:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="imap-page-header" data-imap-page-header><a class="imap-brand" href="/" aria-label="Hanoi iMap — trang chủ"><BrandLogo /></a><h1>iMap · Hà Nội</h1><div class="imap-header-actions"><button type="button" data-heritage-header-open aria-haspopup="dialog" aria-controls="heritage-drawer" aria-expanded="false">Hỏi Heritage</button><a href="/#explore">Về trang chủ ↗</a></div></header>
    <main data-imap-viewport-container><IMap idPrefix="full-imap" headerSelector="[data-imap-page-header]" /></main>
    <HeritageLauncher />
  </body>
</html>
<style>
  body { margin: 0; background: #fff; color: #242724; font-family: 'Be Vietnam Pro', Arial, sans-serif; }
  .imap-page-header { box-sizing: border-box; height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 3vw; background: #F8F7F3; }
  .imap-page-header a { color: inherit; font-size: 12px; text-underline-offset: 5px; }
  .imap-page-header .imap-brand { display: block; flex-shrink: 0; width: 116px; height: 64px; }
  .imap-brand:focus-visible { outline: 2px solid #173d38; outline-offset: 3px; }
  .imap-page-header h1 { margin: 0; font: 400 27px/1.3 'Lora', Georgia, serif; letter-spacing: -.03em; }
  .imap-header-actions { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
  .imap-header-actions button { min-height: 44px; padding: 8px 12px; border: 1px solid #a58c61; border-radius: 24px; background: transparent; color: #173d38; font: inherit; font-size: 12px; cursor: pointer; }
  .imap-header-actions button:focus-visible { outline: 2px solid #173d38; outline-offset: 2px; }
  main { max-width: 1600px; margin-inline: auto; padding: 28px clamp(24px, 3.3vw, 48px); }
  @media (max-width: 960px) {
    .imap-page-header { height: 56px; padding: 8px 20px; gap: 8px; }
    .imap-page-header .imap-brand { width: 80px; height: 44px; }
    .imap-page-header h1 { font-size: clamp(14px, 4.5vw, 22px); white-space: nowrap; }
    .imap-page-header a { font-size: 10px; white-space: nowrap; }
    .imap-header-actions { gap: 8px; }
    .imap-header-actions button { padding: 6px 8px; font-size: 10px; white-space: nowrap; }
    .imap-header-actions a { display: none; }
    main { padding: 20px; }
  }
</style>
