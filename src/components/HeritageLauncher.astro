---
import { companion } from '../data/national/companion';
import { translate, type Language } from '../data/national/locale';

interface Props { scope?: 'national'; lang?: Language }
const { scope, lang = 'vi' } = Astro.props;
const national = scope === 'national';
const t = (value: Parameters<typeof translate>[0]) => translate(value, lang);
---
<div data-heritage-assistant data-heritage-scope={scope} data-heritage-lang={national ? lang : undefined}>
  <button class="heritage-tab" type="button" data-heritage-open data-heritage-visibility="hidden" aria-label={national ? t(companion.title) : "Hỏi Heritage nhé"} aria-haspopup="dialog" aria-controls="heritage-drawer" aria-expanded="false" hidden inert>
    <span aria-hidden="true" class="heritage-monogram">H</span><span class="heritage-tab-label">HỎI HERITAGE</span>
  </button>
  <dialog id="heritage-drawer" class="heritage-drawer" aria-labelledby="heritage-drawer-title" aria-describedby="heritage-capability">
    <header class="heritage-drawer-header">
      <div class="heritage-heading-row">
        <div><p class="heritage-kicker">{national ? t(companion.kicker) : "HERITAGE GUIDE · HÀ NỘI"}</p><h2 id="heritage-drawer-title">{national ? t(companion.title) : "Hỏi Heritage"}<span>.</span></h2><p class="heritage-description">{national ? t(companion.label) : "Một người bạn có gu, dành riêng cho bạn."}</p></div>
        <button type="button" class="heritage-close" data-heritage-close aria-label={national ? t(companion.close) : "Đóng Hỏi Heritage"} autofocus>×</button>
      </div>
      <p id="heritage-capability" class="heritage-disclosure">{national ? t(companion.capability) : "Chỉ khám phá Hà Nội · Gợi ý theo kịch bản, không phải dữ liệu thời gian thực"}</p>
    </header>
    <div class="heritage-conversation" data-heritage-conversation tabindex="0" aria-label={national ? t(companion.conversation) : "Câu hỏi và trả lời"}>
      <p class="heritage-intro">{national ? t(companion.intro) : "BẮT ĐẦU MỘT CÂU CHUYỆN VỀ HÀ NỘI"}</p>
      <div data-heritage-messages role="log" aria-label={national ? t(companion.conversation) : "Trao đổi với Heritage"} aria-live="polite" aria-relevant="additions">
        <div class="heritage-message bot"><span class="heritage-avatar" aria-hidden="true">H</span><div class="heritage-bubble"><div class="heritage-msg-label">HERITAGE</div><div>{national ? t(companion.welcome) : <>Chào bạn, mình là Heritage. 🌿<br /><br />Bạn đang tìm một góc Hà Nội để khám phá, một món ngon đúng gu hay một lịch trình đi chơi thật vừa vặn?<br /><br />Kể mình nghe bạn thích gì nhé.</>}</div></div></div>
      </div>
    </div>
    <section class="heritage-suggestions" aria-label={national ? t(companion.suggestions) : "Gợi ý câu hỏi"}><p class="heritage-sugg-label">{national ? t(companion.suggestions).toLocaleUpperCase(lang) : "GỢI Ý ĐỂ BẮT ĐẦU"}</p><div class="heritage-prompts" data-heritage-prompts></div></section>
    <form class="heritage-input" data-heritage-form>
      <p class="heritage-sr-only" data-heritage-status role="status" aria-live="polite"></p>
      <label class="heritage-sr-only" for="heritage-question">{national ? t(companion.questionLabel) : "Câu hỏi của bạn"}</label>
      <div class="heritage-input-row">
        <textarea id="heritage-question" name="query" rows="1" maxlength="600" required aria-describedby="heritage-capability" placeholder={national ? t(companion.placeholder) : "Hỏi về Hà Nội…"}></textarea>
        <button type="submit" data-heritage-send aria-label={national ? t(companion.send) : "Gửi câu hỏi"}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m4 12 16-8-5 16-3-7-8-1zm8 1 8-9" /></svg></button>
      </div>
      <p class="heritage-foot">{national ? t(companion.foot) : "DEMO MIỄN PHÍ · Không gọi AI/API · Không lưu hội thoại"}</p>
    </form>
  </dialog>
</div>
<script>import '../scripts/heritage-assistant';</script>
<style>
  .heritage-tab {
    --heritage-tab-width: 36px;
    --heritage-tab-height: 152px;
    --heritage-compact-size: 44px;
    --heritage-safe-top: env(safe-area-inset-top, 0px);
    --heritage-safe-bottom: env(safe-area-inset-bottom, 0px);
    --heritage-tab-metal: linear-gradient(125deg, #3a6158 4%, #4f746b 28%, #3d635a 43%, #31554e 69%, #446e64);
    box-sizing: border-box; position: fixed; z-index: 2100; right: env(safe-area-inset-right, 0px);
    top: var(--heritage-dock-y, 50%); transform: translateY(-50%);
    width: var(--heritage-tab-width); height: var(--heritage-tab-height); padding: 0;
    display: flex; align-items: center; justify-content: center; gap: 12px; writing-mode: vertical-rl;
    border: 1px solid #5d7e75; border-right: 0; border-radius: 12px 0 0 12px;
    background: var(--heritage-tab-metal); color: #fff; box-shadow: inset 1px 0 #ffffff29, -3px 2px 12px #173d3820;
    font: 500 10px/1.5 var(--editorial-body, 'Be Vietnam Pro', Arial, sans-serif); letter-spacing: .14em; cursor: pointer;
    transition: opacity .2s ease, visibility .2s;
  }
  .heritage-monogram { font: italic 20px/1 Georgia, serif; }
  .heritage-tab[hidden] { display: none; }
  .heritage-tab[data-heritage-visibility="hidden"] { opacity: 0; visibility: hidden; pointer-events: none; }
  .heritage-tab[data-heritage-dock="compact"] { width: var(--heritage-compact-size); height: var(--heritage-compact-size); writing-mode: horizontal-tb; }
  .heritage-tab[data-heritage-dock="compact"] .heritage-tab-label { display: none; }
  .heritage-tab:hover { background: linear-gradient(#ffffff0c, #ffffff0c), var(--heritage-tab-metal); }
  .heritage-drawer { box-sizing: border-box; position: fixed; inset: auto 20px max(20px, env(safe-area-inset-bottom)) auto; width: min(416px, calc(100vw - 32px)); max-width: 100vw; height: min(704px, calc(var(--heritage-viewport-height, 100dvh) - var(--heritage-drawer-top, 0px) - 32px)); max-height: calc(var(--heritage-viewport-height, 100dvh) - var(--heritage-drawer-top, 0px) - 20px); margin: 0; padding: 0; overflow: hidden; overscroll-behavior: contain; border: 1px solid #d9e3dc; border-radius: 18px; background: #fafaf7; color: #344b45; box-shadow: 0 28px 90px #0c262231; font: 400 13px/1.65 var(--editorial-body, 'Be Vietnam Pro', Arial, sans-serif); }
  .heritage-drawer[open] { display: flex; flex-direction: column; animation: heritage-enter .2s ease-out; }
  .heritage-drawer::backdrop { background: #173d381a; }
  .heritage-drawer-header { flex-shrink: 0; padding: 20px 20px 18px; background: #173d38; color: #fff; }
  .heritage-heading-row { display: flex; justify-content: space-between; align-items: start; gap: 12px; }
  .heritage-kicker { margin: 0 0 5px; font-size: 9px; letter-spacing: .2em; color: #d3c09b; }
  .heritage-drawer-header h2 { margin: 0 0 4px; font: 400 28px/1.25 var(--editorial-display, 'Lora', Georgia, serif); letter-spacing: -.04em; }
  .heritage-drawer-header h2 span { color: #c8b590; }
  .heritage-description { margin: 0; font-size: 11px; color: #d3e3d9; }
  .heritage-close { flex-shrink: 0; width: 44px; height: 44px; border: 1px solid #ffffff38; border-radius: 50%; background: transparent; color: inherit; font: 400 26px/1 Arial, sans-serif; cursor: pointer; }
  .heritage-close:hover { background: #ffffff20; }
  .heritage-disclosure { margin: 16px 0 0; padding-top: 12px; border-top: 1px solid #ffffff30; font-size: 10px; line-height: 1.6; color: #d3e3d9; }
  .heritage-conversation { min-height: 44px; flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 22px 16px; overflow-wrap: anywhere; }
  .heritage-intro { margin: 0 0 20px; text-align: center; color: #697c79; font-size: 9px; }
  .heritage-drawer :global(.heritage-message) { display: flex; gap: 8px; align-items: start; margin-bottom: 17px; }
  .heritage-drawer :global(.heritage-message.user) { justify-content: end; }
  .heritage-drawer :global(.heritage-avatar) { display: grid; place-items: center; width: 27px; height: 27px; flex-shrink: 0; border-radius: 50%; background: #e7eee7; color: #173d38; font: italic 17px Georgia, serif; }
  .heritage-drawer :global(.heritage-bubble) { box-sizing: border-box; max-width: calc(100% - 35px); border: 1px solid #e4e8e3; border-radius: 3px 12px 12px; background: #fff; padding: 13px 14px; font-size: 12px; line-height: 1.8; white-space: pre-line; overflow-wrap: anywhere; }
  .heritage-drawer :global(.user .heritage-bubble) { background: #e9f0e9; border-radius: 12px 3px 12px 12px; color: #173d38; }
  .heritage-drawer :global(.heritage-msg-label) { margin-bottom: 6px; color: #697c79; font-size: 9px; letter-spacing: .16em; }
  .heritage-suggestions { flex-shrink: 0; margin: 0; padding: 12px 14px 9px; border-top: 1px solid #e4e8e3; background: #fff; }
  .heritage-sugg-label { margin: 0 0 8px; font-size: 9px; letter-spacing: .14em; color: #806847; }
  .heritage-prompts { display: flex; gap: 6px; flex-wrap: wrap; }
  .heritage-prompts :global(button) { min-height: 44px; padding: 7px 10px; border: 1px solid #dce5dd; border-radius: 24px; background: #fff; color: #35544c; font: inherit; font-size: 10px; cursor: pointer; }
  .heritage-prompts :global(button:hover) { background: #eef4ed; }
  .heritage-input { flex-shrink: 0; margin: 0; padding: 12px max(12px, env(safe-area-inset-right)) max(10px, env(safe-area-inset-bottom)) 12px; border-top: 1px solid #edf0eb; background: #fff; }
  .heritage-input-row { display: flex; align-items: end; gap: 8px; }
  .heritage-input textarea { box-sizing: border-box; min-width: 0; flex: 1; min-height: 44px; max-height: 107px; padding: 11px 12px; resize: none; border: 1px solid #91ab9b; border-radius: 11px; background: #fff; color: inherit; font: inherit; font-size: 12px; line-height: 1.6; }
  .heritage-input-row button { display: grid; place-items: center; flex-shrink: 0; min-width: 44px; min-height: 44px; border: 0; border-radius: 11px; background: #173d38; color: #fff; cursor: pointer; }
  .heritage-foot { margin: 8px 0 0; text-align: center; color: #697c79; font-size: 8px; }
  .heritage-drawer button:disabled { opacity: .55; cursor: wait; }
  .heritage-tab:focus-visible, .heritage-drawer :focus-visible { outline: 2px solid #a77e48; outline-offset: -3px; }
  .heritage-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @keyframes heritage-enter { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }
  @media (max-width: 720px) {
    .heritage-drawer { inset: auto 0 calc(100dvh - var(--heritage-viewport-height, 100dvh)) auto; width: 100vw; height: min(90dvh, calc(var(--heritage-viewport-height, 100dvh) - var(--heritage-drawer-top, 0px) - 8px)); max-height: calc(var(--heritage-viewport-height, 100dvh) - var(--heritage-drawer-top, 0px) - 8px); border-radius: 19px 19px 0 0; }
    .heritage-input textarea { font-size: 16px; }
    .heritage-drawer-header { padding: 16px; }
    .heritage-drawer-header h2 { font-size: 25px; }
    .heritage-conversation { padding: 18px 14px; }
    @keyframes heritage-enter { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  }
  @media (max-height: 600px) { .heritage-description, .heritage-intro, .heritage-sugg-label { display: none; } .heritage-suggestions { max-height: 66px; overflow-y: auto; } .heritage-drawer-header { padding-block: 8px; } .heritage-disclosure { margin-top: 4px; padding-top: 4px; } }
  @media (prefers-reduced-motion: reduce) {
    .heritage-tab { transition: none; }
    .heritage-drawer[open] { animation: none; }
  }
</style>
