---
// Map templates retain their original player contract, independent of editorial cards.
interface Props { videoId: string; title: string }
const { videoId, title } = Astro.props;
---
<div class="heritage-video">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${videoId}`}
    title={`Video: ${title}`}
    width="560"
    height="315"
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="encrypted-media; picture-in-picture; fullscreen"
    allowfullscreen
  ></iframe>
</div>
<style>
  .heritage-video { aspect-ratio: 16 / 9; min-height: 200px; background: #202020; }
  iframe { display: block; width: 100%; height: 100%; min-height: 200px; border: 0; }
</style>
