---
import Icon from './Icon.astro';
import DemoMap from './DemoMap.astro';
import MapStoryVideo from './MapStoryVideo.astro';
import { places } from '../data/places';
import { districtGroups, districtPlaceSlugs, hanoiOverviewVideo } from '../data/districts';
---
<section class="map-section" aria-labelledby="map-heading">
  <div class="section-heading">
    <div><p class="eyebrow">BẢN ĐỒ KHÁM PHÁ</p><h2 id="map-heading">Dạo một vòng Hà Nội</h2><p id="location-label"><span class="status-dot"></span>Bắt đầu tại Hồ Hoàn Kiếm · vị trí mẫu</p></div>
    <button id="locate" class="button secondary" type="button"><Icon name="locate" size={20} /><span>Dùng vị trí của tôi</span></button>
  </div>
  <div class="map-explorer">
    <aside id="map-sidebar" class="map-sidebar" aria-label="Khu vực và địa điểm Hà Nội">
      <div id="map-districts">
        <h3 id="districts-heading" tabindex="-1">Các quận, huyện Hà Nội</h3>
        <p class="district-note">30 khu vực theo tên quận, huyện, thị xã cũ trước 01/07/2025, không phải đơn vị hành chính hiện hành. <a href="https://hanoi.gov.vn/videos/ha-noi-cong-bo-nghi-quyet-sap-xep-don-vi-hanh-chinh-van-hanh-chinh-quyen-hai-cap-tu-1-7-2025-425063022371804.htm">Thông tin sắp xếp ↗</a></p>
        <p class="district-note">Chọn khu vực để xem địa điểm tuyển chọn, hoặc chọn một ghim trên bản đồ. Bản mẫu có 6 địa điểm; danh sách không vẽ ranh giới hành chính.</p>
        {districtGroups.map(group => (
          <section class="district-group" aria-label={group.label}>
            <h4>{group.label}</h4>
            {group.names.map(name => {
              const districtPlaces = places.filter(place => districtPlaceSlugs[name]?.includes(place.slug));
              return (
                <details class="district-entry">
                  <summary><span>{name}</span><span class="district-count" data-district-count>{districtPlaces.length}</span></summary>
                  <ul class="district-places">
                    {districtPlaces.map(place => <li><a href={`/places/${place.slug}/`} data-map-place={place.slug} aria-controls="map-place-detail">{place.name}<Icon name="arrow" size={16} /></a></li>)}
                  </ul>
                  <p class="district-empty" data-district-empty hidden={districtPlaces.length > 0}>{districtPlaces.length ? 'Không có địa điểm phù hợp bộ lọc.' : 'Chưa có địa điểm tuyển chọn trong bản mẫu.'}</p>
                </details>
              );
            })}
          </section>
        ))}
      </div>
      <div id="map-place-detail" hidden>
        <button id="map-detail-back" class="map-detail-back" type="button">← Trở lại danh sách khu vực</button>
        <div id="map-detail-content"></div>
      </div>
    </aside>
    <div class="map-frame">
      <DemoMap />
      <div id="live-map" class="live-map" hidden aria-label="Bản đồ tương tác các địa điểm Hà Nội"></div>
      <span id="live-map-label" class="live-map-label" hidden>Chọn một ghim để xem câu chuyện</span>
    </div>
  </div>
  {places.map(place => (
    <template data-map-detail={place.slug}>
      <article class="map-place-story" aria-labelledby={`map-place-${place.slug}`}>
        <MapStoryVideo videoId={hanoiOverviewVideo.id} title={hanoiOverviewVideo.label} />
        <p class="map-video-credit"><a href={hanoiOverviewVideo.source}>{hanoiOverviewVideo.label}</a> · Video giới thiệu thành phố, không phải video riêng của địa điểm này. <a href={`https://www.youtube.com/watch?v=${hanoiOverviewVideo.id}`}>Xem trên YouTube ↗</a></p>
        <h3 id={`map-place-${place.slug}`} tabindex="-1">{place.name}</h3>
        <p class="map-place-area">{place.area} · {place.category}</p>
        <p class="map-place-description">{place.story}</p>
        <a class="button primary" href={`/places/${place.slug}/`}>Đọc thêm <Icon name="arrow" size={18} /></a>
      </article>
    </template>
  ))}
  <div class="map-footnote"><span><span class="legend-dot"></span>Địa điểm khám phá <span class="legend-dot blue"></span>Điểm xuất phát</span><span id="map-status" role="status">Đang tải bản đồ… Bạn có thể chọn ghim trên sơ đồ minh họa.</span></div>
  <button id="retry-map" class="reset-location" type="button" hidden>Thử tải lại bản đồ tương tác</button>
  <p id="location-message" class="location-message" role="status"></p>
</section>

<style>
  .map-explorer { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); border: 1px solid #bcc9c1; }
  .map-sidebar { height: 640px; min-width: 0; overflow-y: auto; overscroll-behavior-y: contain; padding: 28px 24px; background: #eaf0fb; scrollbar-gutter: stable; }
  .map-sidebar h3 { font-size: 25px; line-height: 1.3; }
  .district-note { margin-top: 14px; font-size: 13px; line-height: 1.6; color: #48546b; }
  .district-note a, .map-video-credit a { text-decoration: underline; text-underline-offset: 3px; }
  .district-group { margin-top: 28px; }
  .district-group h4 { margin-bottom: 10px; color: #48546b; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; }
  .district-entry { border-top: 1px solid #d6deed; }
  .district-entry summary { display: flex; align-items: center; gap: 12px; min-height: 48px; padding-block: 12px; font-weight: 600; list-style: none; }
  .district-entry summary::-webkit-details-marker { display: none; }
  .district-entry summary::before { content: '+'; display: grid; place-items: center; width: 20px; height: 20px; border: 1px solid currentColor; border-radius: 50%; flex-shrink: 0; font-size: 16px; }
  .district-entry[open] summary::before { content: '−'; }
  .district-count { margin-left: auto; color: #48546b; font-size: 12px; }
  .district-places { list-style: none; margin: 0; padding: 0 0 8px 32px; }
  .district-places a { display: flex; justify-content: space-between; align-items: center; gap: 8px; min-height: 44px; padding-block: 8px; font-size: 15px; }
  .district-places a:hover { color: var(--red-dark); text-decoration: underline; }
  .district-empty { padding: 0 0 16px 32px; font-size: 13px; line-height: 1.5; color: #48546b; }
  .map-detail-back { display: block; width: 100%; margin-bottom: 20px; min-height: 44px; padding: 8px 0; text-align: left; font-weight: 700; color: var(--ink); background: transparent; }
  .map-explorer .map-frame { height: 640px; min-width: 0; border: 0; border-left: 1px solid #bcc9c1; }
  .map-place-story h3 { margin-top: 22px; }
  .map-video-credit { margin-top: 10px; font-size: 12px; line-height: 1.5; color: #48546b; }
  .map-place-area { margin-top: 12px; font-size: 13px; color: #48546b; }
  .map-place-description { margin-block: 16px 24px; font-size: 16px; line-height: 1.7; }
  @media (max-width: 900px) {
    .map-explorer { grid-template-columns: minmax(0, 1fr); }
    .map-sidebar { height: auto; max-height: 520px; }
    .map-explorer .map-frame { height: 440px; border-left: 0; border-top: 1px solid #bcc9c1; }
  }
  @media (max-width: 540px) {
    .map-sidebar { padding: 24px 16px; }
    .map-explorer .map-frame { height: 350px; }
  }
</style>
