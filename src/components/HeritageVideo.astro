---
import type { HeritageStory } from '../data/heritage';
interface Props { video: HeritageStory; featured?: boolean }
const { video, featured = false } = Astro.props;
const { videoId, title, cover, url: videoUrl } = video;
const dialogId = `heritage-video-${videoId}`;
---
<div class:list={['heritage-video', { 'is-featured': featured }]}>
  <!-- Cover approval is tracked internally in the story record.
       Keep the typographic fallback if a cover fails to load. -->
  <a class:list={['editorial-cover', { 'has-photograph': cover }]} href={videoUrl} data-video-trigger data-video-id={videoId} aria-label={`Xem video: ${title}`} aria-haspopup="dialog" aria-controls={dialogId}>
    {cover && <img class="cover-photograph" src={cover.src} alt={cover.alt} width={cover.width ?? 1600} height={cover.height ?? 1067} loading="lazy" decoding="async" style={{ '--heritage-cover-position': cover.position || '50% 50%' }} />}
    <span class="cover-placeholder" aria-hidden="true"><span>Ảnh câu chuyện</span><span>đang được tuyển chọn.</span></span>
    <span class="play-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span>
  </a>
  <dialog id={dialogId} class="video-dialog" aria-labelledby={`${dialogId}-title`}>
    <div class="dialog-heading"><h2 id={`${dialogId}-title`}>{title}</h2><button type="button" data-video-close autofocus aria-label="Đóng video">Đóng <span aria-hidden="true">×</span></button></div>
    <div class="video-player" data-video-player></div>
    <p>Không xem được video? <a href={videoUrl} target="_blank" rel="noopener noreferrer">Mở video gốc trên YouTube ↗</a></p>
  </dialog>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.heritage-video').forEach(component => {
    const trigger = component.querySelector<HTMLAnchorElement>('[data-video-trigger]');
    const dialog = component.querySelector<HTMLDialogElement>('dialog');
    const player = component.querySelector<HTMLElement>('[data-video-player]');
    const close = component.querySelector<HTMLButtonElement>('[data-video-close]');
    if (!trigger || !dialog || !player || !close || typeof dialog.showModal !== 'function') return;
    let previousOverflow = '';
    let returnFocus = trigger;
    const photograph = component.querySelector<HTMLImageElement>('.cover-photograph');
    const showFallback = () => {
      photograph?.remove();
      trigger.classList.remove('has-photograph');
    };
    photograph?.addEventListener('error', showFallback, { once: true });
    if (photograph?.complete && !photograph.naturalWidth) showFallback();
    const triggers = component.closest('article')?.querySelectorAll<HTMLAnchorElement>('[data-video-trigger]') || [trigger];
    triggers.forEach(storyTrigger => storyTrigger.addEventListener('click', event => {
      // Preserve normal open-in-new-tab and link fallback behavior.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const videoId = trigger.dataset.videoId;
      if (!videoId || dialog.open) return;
      event.preventDefault();
      returnFocus = storyTrigger;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}`;
      frame.title = trigger.getAttribute('aria-label') || 'Video Heritage Guide';
      frame.allow = 'encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      previousOverflow = document.body.style.overflow;
      dialog.showModal();
      document.body.style.overflow = 'hidden';
      player.replaceChildren(frame);
    }));
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      const bounds = dialog.getBoundingClientRect();
      if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) dialog.close();
    });
    // Native dialog supplies the focus trap and Escape/cancel behavior.
    dialog.addEventListener('close', () => {
      player.replaceChildren();
      document.body.style.overflow = previousOverflow;
      returnFocus.focus({ preventScroll: true });
    });
  });
</script>
<style>
  .heritage-video { min-width: 0; }
  .editorial-cover { position: relative; display: flex; flex-direction: column; justify-content: space-between; width: 100%; min-height: var(--heritage-cover-min-height, 220px); aspect-ratio: var(--heritage-cover-ratio, 16 / 9); padding: 20px; overflow: hidden; color: var(--deep-ink); background: #e7e5dc; }
  .is-featured .editorial-cover { aspect-ratio: var(--editorial-image-ratio); padding: 30px; background: #dde1d7; }
  .cover-placeholder { display: flex; flex-direction: column; align-self: start; margin-block: 24px; font-family: var(--editorial-display); font-size: clamp(22px, 2.3vw, 34px); font-weight: 400; line-height: 1.35; letter-spacing: -.035em; color: #535c52; }
  .cover-placeholder span:last-child { font-size: .72em; font-style: italic; margin-top: 8px; }
  .is-featured .cover-placeholder { font-size: clamp(32px, 3.5vw, 50px); }
  .cover-photograph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--heritage-cover-position, 50% 50%); }
  .has-photograph .cover-placeholder { display: none; }
  .has-photograph .play-icon { background: var(--rice-paper); color: var(--deep-ink); border-color: transparent; }
  .has-photograph::after { content: ''; position: absolute; inset: 60% 0 0; background: linear-gradient(transparent, #14181270); pointer-events: none; }
  .play-icon { position: absolute; left: 20px; bottom: 20px; z-index: 1; width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid #68736780; border-radius: 50%; transition: background .2s, color .2s; }
  .editorial-cover:hover .play-icon { color: var(--rice-paper); background: var(--deep-ink); }
  .video-dialog { width: min(1040px, calc(100% - 40px)); max-height: calc(100svh - 40px); padding: 24px; border: 0; overflow: auto; color: var(--deep-ink); background: var(--rice-paper); font-family: var(--editorial-body); }
  .video-dialog::backdrop { background: rgb(18 22 19 / .82); }
  .dialog-heading { display: flex; align-items: start; justify-content: space-between; gap: 24px; margin-bottom: 20px; }
  .dialog-heading h2 { max-width: 750px; font: 400 clamp(20px, 3vw, 30px)/1.4 var(--editorial-display); letter-spacing: -.02em; }
  .dialog-heading button { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 8px; background: transparent; color: inherit; font-size: 12px; white-space: nowrap; }
  .dialog-heading button span { font-size: 26px; }
  .video-player { aspect-ratio: 16 / 9; background: var(--deep-ink); }
  .video-player :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .video-dialog p { margin-top: 18px; font-size: 12px; line-height: 1.8; }
  .video-dialog p a { display: inline-block; padding-block: 8px; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 700px) {
    /* Override both desktop ratios and inherited supporting-card minimums.
       Contain keeps the full supplied compositions inside equal landscape frames. */
    .editorial-cover, .is-featured .editorial-cover { min-height: 0; height: auto; padding: 20px; aspect-ratio: 16 / 9; }
    .cover-photograph { object-fit: contain; object-position: 50% 50%; }
    .cover-placeholder, .is-featured .cover-placeholder { font-size: clamp(26px, 7.5vw, 40px); margin-block: 20px; }
    .video-dialog { padding: 16px; width: calc(100% - 24px); }
    .dialog-heading { gap: 12px; }
  }
</style>
