---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PrototypeExplorer from '../components/imap/PrototypeExplorer.astro';
import LowerHomepage from '../components/LowerHomepage.astro';
import HomepageFooter from '../components/HomepageFooter.astro';
import HeritageChoice from '../components/HeritageChoice.astro';
import HeritageExperiences from '../components/HeritageExperiences.astro';
---
<Layout wide overlayHeader>
  <section class="hero" aria-labelledby="hero-heading">
    <svg class="hero-tone-map" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="hero-shadow-detail" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="gamma" amplitude="1" exponent="0.86" offset="0" />
            <feFuncG type="gamma" amplitude="1" exponent="0.86" offset="0" />
            <feFuncB type="gamma" amplitude="1" exponent="0.86" offset="0" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
    <img class="hero-image" src="/images/Ho%20tay%20binh%20minh%20tren%20cao.jpg" alt="Hồ Tây nhìn từ trên cao trong ánh bình minh, với đường ven hồ và thành phố phía xa" width="1200" height="882" fetchpriority="high" loading="eager" />
    <div class="hero-video" id="hero-background" data-hero-video aria-hidden="true" inert></div>
    <div class="hero-shade"></div>
    <div class="hero-content shell">
      <div class="hero-copy">
      <h1 id="hero-heading">Khám phá Hà Nội<br class="hero-headline-break" /> của riêng bạn</h1>
      <p class="hero-description">Di sản – Văn hiến – Sáng tạo.<br />Thiết lập hành trình mang đậm phong cách cá nhân.</p>
      <a class="button hero-button" href="#explore">Khám phá ngay cùng iMap <Icon name="arrow" size={21} /></a>
      </div>
    </div>
    <button class="hero-video-toggle" type="button" data-hero-video-toggle aria-label="Tạm dừng video nền" aria-controls="hero-background" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path data-pause-icon d="M8 5v14M16 5v14" /><path data-play-icon d="m8 5 11 7-11 7Z" /></svg>
    </button>
  </section>

  <div id="explore" class="explore-section">
    <PrototypeExplorer embedded />

    <HeritageChoice />
    <HeritageExperiences />

  </div>

  <LowerHomepage />
  <HomepageFooter slot="footer" />
</Layout>
<script>import '../scripts/hero-background';</script>
<style>
  /* Local Explorer canvas; do not recolor map tiles, panels or cards. */
  #explore { padding-block: 0; background: #FFFFFF; }
</style>
