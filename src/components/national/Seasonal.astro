---
import Photo from './Photo.astro';
import Icon from '../shared/Icon.astro';
import { campaigns, hubHref, previewCampaign } from '../../data/national/content';
import { translate, ui, type Language } from '../../data/national/locale';
import { activeWindow, httpsLink } from '../../lib/national-selection';

interface Props { lang: Language; today: string }
const { lang, today } = Astro.props;
const t = (value: Parameters<typeof translate>[0]) => translate(value, lang);
const active = campaigns.find(item => activeWindow(item, today));
const campaign = active ?? previewCampaign;
---
<section id="seasonal" class="n-seasonal n-section" aria-labelledby="seasonal-title">
  <div class="n-seasonal-image">
    <Photo photo={campaign.photo} {lang} sizes="100vw" />
    <div class="n-seasonal-copy n-shell">
      <p class="n-eyebrow"><span>03</span> · SEASONAL HERITAGE{campaign.sponsored ? ' · ' + t(ui.sponsorLabel) : ''}</p>
      <h2 id="seasonal-title">{t(campaign.title)}</h2>
      <p>{t(campaign.description)}</p>
      <span class="n-caption">{t(active ? ui.imagery : ui.review)}{!active && ' · ' + t(ui.imagery)}</span>
      <a class="n-button n-button-light" href="#seasonal-selection" data-open-seasonal>{t(ui.selection)} <Icon name="arrow" size={17} /></a>
    </div>
  </div>
  <details id="seasonal-selection" class="n-seasonal-selection n-shell">
    <summary><span>{t(ui.selection)}</span><Icon name="arrow" size={20} /></summary>
    <div class="n-seasonal-stories">
      {campaign.stories.map(story => {
        const booking = active && httpsLink(story.booking);
        return (
          <article>
            <Photo photo={story.photo} {lang} sizes="(max-width: 660px) 90vw, 48vw" />
            <h3>{t(story.title)}</h3>
            <p>{t(story.description)}</p>
            <a class="n-text-link" href={hubHref(story.destinationId) ?? '#destination-' + story.destinationId}>{t(ui.visit)} <Icon name="arrow" size={16} /></a>
            {booking && <a class="n-text-link" href={booking} target="_blank" rel="noopener noreferrer sponsored">{t(ui.booking)} ↗</a>}
          </article>
        );
      })}
    </div>
  </details>
</section>
<script>
  const collection = document.querySelector<HTMLDetailsElement>('#seasonal-selection');
  document.querySelector('[data-open-seasonal]')?.addEventListener('click', () => {
    if (collection) collection.open = true;
  });
</script>
