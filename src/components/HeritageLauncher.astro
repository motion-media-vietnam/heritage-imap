---
import HeritageSparkle from './HeritageSparkle.astro';
const prompts = ['Gợi ý địa điểm tiếp khách đối tác', 'Một buổi hẹn hò thật đặc biệt', 'Khám phá Hà Nội trong 1 ngày'];
---
<div data-heritage-assistant>
  <button class="heritage-tab" type="button" data-heritage-open aria-haspopup="dialog" aria-controls="heritage-drawer" aria-expanded="false" hidden>
    <HeritageSparkle /><span>Hỏi Heritage nhé</span>
  </button>
  <dialog id="heritage-drawer" class="heritage-drawer" aria-labelledby="heritage-drawer-title" aria-describedby="heritage-capability">
    <header class="heritage-drawer-header">
      <h2 id="heritage-drawer-title"><HeritageSparkle />Hỏi Heritage nhé</h2>
      <button type="button" class="heritage-close" data-heritage-close aria-label="Đóng Hỏi Heritage" autofocus>×</button>
    </header>
    <div class="heritage-conversation" data-heritage-conversation tabindex="0" aria-label="Câu hỏi và kết quả gợi ý">
      <h3>Bạn muốn khám phá một Hà Nội như thế nào?</h3>
      <p>Heritage sẽ giúp bạn tìm những địa điểm và trải nghiệm phù hợp với sở thích của mình.</p>
      <p id="heritage-capability" class="heritage-disclosure">AI hội thoại chưa được kết nối. Hiện chỉ có gợi ý theo dữ liệu từ 6 địa điểm có sẵn; không tra cứu trực tiếp hay trò chuyện bằng AI.</p>
      <div class="heritage-prompts" role="group" aria-label="Thử một câu hỏi">
        {prompts.map(prompt => <button type="button" data-heritage-prompt={prompt}>{prompt}</button>)}
      </div>
      <div data-heritage-messages role="log" aria-label="Trao đổi với Heritage" aria-live="polite" aria-relevant="additions"></div>
    </div>
    <form class="heritage-input" data-heritage-form>
      <p class="heritage-request-status" data-heritage-status role="status" aria-live="polite"></p>
      <label for="heritage-question">Câu hỏi của bạn</label>
      <div class="heritage-input-row">
        <textarea id="heritage-question" name="query" rows="2" maxlength="600" required aria-describedby="heritage-capability" placeholder="Bạn muốn hỏi gì về Hà Nội?"></textarea>
        <button type="submit" data-heritage-send aria-label="Gửi câu hỏi để tìm gợi ý trong danh mục"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 12 7-7 7 7M12 5v15" /></svg></button>
      </div>
    </form>
  </dialog>
</div>
<script>import '../scripts/heritage-assistant';</script>
<style>
  .heritage-tab { box-sizing: border-box; position: fixed; z-index: 2100; right: 0; top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 10px; min-width: 44px; padding: 16px max(10px, env(safe-area-inset-right)) 16px 10px; writing-mode: vertical-rl; border: 1px solid #b8a788; border-right: 0; border-radius: 12px 0 0 12px; background: #faf7f0; color: #242724; box-shadow: -3px 2px 12px #24272412; font: 500 12px/1.5 var(--editorial-body, 'Be Vietnam Pro', Arial, sans-serif); cursor: pointer; }
  .heritage-tab[hidden] { display: none; }
  .heritage-tab:hover { background: #f1eadf; }
  .heritage-drawer { box-sizing: border-box; position: fixed; inset: var(--heritage-drawer-top, 0px) 0 0 auto; width: min(410px, 100vw); max-width: 100vw; height: calc(var(--heritage-viewport-height, 100dvh) - var(--heritage-drawer-top, 0px)); max-height: calc(var(--heritage-viewport-height, 100dvh) - var(--heritage-drawer-top, 0px)); margin: 0; padding: 0; overflow: hidden; overscroll-behavior: contain; border: 1px solid #c8baa0; border-right: 0; border-radius: 18px 0 0 18px; background: #faf7f0; color: #242724; box-shadow: -8px 0 32px #2427241a; font: 400 13px/1.65 var(--editorial-body, 'Be Vietnam Pro', Arial, sans-serif); }
  .heritage-drawer[open] { display: flex; flex-direction: column; animation: heritage-enter .2s ease-out; }
  .heritage-drawer::backdrop { background: #24272426; }
  .heritage-drawer-header { flex-shrink: 0; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px max(12px, env(safe-area-inset-right)) 12px 20px; border-bottom: 1px solid #ded5c5; }
  .heritage-drawer-header h2 { display: flex; align-items: center; gap: 8px; margin: 0; font: 500 15px/1.4 var(--editorial-body, 'Be Vietnam Pro', Arial, sans-serif); }
  .heritage-close { flex-shrink: 0; width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; color: inherit; font: 400 26px/1 Arial, sans-serif; cursor: pointer; }
  .heritage-close:hover { background: #f1eadf; }
  .heritage-conversation { min-height: 0; flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 24px 20px; overflow-wrap: anywhere; }
  .heritage-conversation h3 { margin: 0 0 12px; font: 400 23px/1.4 var(--editorial-display, 'Lora', Georgia, serif); }
  .heritage-conversation p { margin: 0 0 14px; }
  .heritage-disclosure { padding: 12px; border: 1px solid #ded5c5; border-radius: 8px; font-size: 11px; color: #53574f; }
  .heritage-prompts { display: grid; gap: 8px; margin-block: 20px; }
  .heritage-prompts button { min-height: 44px; padding: 10px 12px; border: 1px solid #c8baa0; border-radius: 10px; background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .heritage-prompts button:hover { background: #f1eadf; }
  .heritage-input { flex-shrink: 0; margin: 0; padding: 12px max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) 16px; border-top: 1px solid #ded5c5; }
  .heritage-input label { display: block; margin-bottom: 6px; font-size: 11px; }
  .heritage-request-status { margin: 0 0 6px; font-size: 11px; }
  .heritage-input-row { display: flex; align-items: end; gap: 8px; }
  .heritage-input textarea { box-sizing: border-box; min-width: 0; flex: 1; max-height: 120px; padding: 10px 12px; resize: none; border: 1px solid #b8a788; border-radius: 10px; background: #fffdfa; color: inherit; font: inherit; }
  .heritage-input-row button { display: grid; place-items: center; flex-shrink: 0; min-width: 44px; min-height: 44px; border: 1px solid #a58c61; border-radius: 10px; background: #f1eadf; color: #242724; cursor: pointer; }
  .heritage-drawer button:disabled { opacity: .55; cursor: wait; }
  .heritage-tab:focus-visible, .heritage-drawer :focus-visible { outline: 2px solid #242724; outline-offset: -3px; }
  .heritage-drawer :global(.heritage-turn) { margin-block: 18px; padding-top: 16px; border-top: 1px solid #ded5c5; }
  .heritage-drawer :global(.heritage-turn h4) { margin: 0 0 12px; font: 600 13px/1.6 var(--editorial-body, 'Be Vietnam Pro', Arial, sans-serif); overflow-wrap: anywhere; }
  .heritage-drawer :global(.heritage-turn ul) { padding-left: 20px; }
  .heritage-drawer :global(.heritage-turn li) { margin-block: 10px; }
  @keyframes heritage-enter { from { transform: translateX(100%); } to { transform: translateX(0); } }
  @media (max-width: 960px) {
    .heritage-tab { font-size: 11px; padding-block: 12px; }
    .heritage-drawer { width: 100vw; border-radius: 12px 0 0 12px; }
    .heritage-input textarea { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .heritage-drawer[open] { animation: none; } }
</style>
