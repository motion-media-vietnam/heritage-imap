---
import Icon from '../../shared/Icon.astro';
import artwork from '../../../assets/national/listing/wine-orchid-burgundy-lace-hero.webp?url';
import { listingCopy, listingHref, listingPath, listingProvinces } from '../../../data/national/listing';
import { translate, type Language } from '../../../data/national/locale';

interface Props { lang: Language; query: string; unmatched: boolean }
const { lang, query, unmatched } = Astro.props;
const t = (value: Parameters<typeof translate>[0]) => translate(value, lang);
const suggestions = listingProvinces.map(({ id, nameVi, nameEn, aliases, type, provinceId }) =>
  ({ id, nameVi, nameEn, aliases, type, provinceId }));
---
<section class="listing-hero" aria-labelledby="listing-title" data-heritage-chat-zone="immersive">
  <img class="listing-artwork" src={artwork} width="1899" height="828" loading="eager" fetchpriority="high" decoding="async"
    alt={t(['Ly vang đỏ và cánh lan trên khăn đỏ đô phủ ren trắng', 'A glass of red wine and orchid petals on a burgundy tablecloth with white lace'])} />
  <div class="listing-intro">
    <h1 id="listing-title">{t(listingCopy.headline)}</h1>
    <form action={listingPath} role="search" aria-label={t(listingCopy.search)}
      data-listing-search data-provinces={JSON.stringify(suggestions)} data-lang={lang} data-heritage-chat-zone="content">
      {lang === 'en' && <input type="hidden" name="lang" value="en" />}
      <div class="listing-search-box">
        <button type="submit" aria-label={t(listingCopy.searchButton)}><Icon name="search" size={20} /></button>
        <input name="q" type="search" maxlength="80" aria-label={t(listingCopy.search)}
          placeholder={t(listingCopy.search)} value={query} autocomplete="off"
          aria-describedby={unmatched ? 'listing-search-error' : undefined} />
      </div>
      <ul class="listing-suggestions" aria-label={t(listingCopy.suggestions)} hidden></ul>
      {unmatched && <p id="listing-search-error" role="status">{t(listingCopy.noMatch)} <a href={listingHref(lang)}>{t(listingCopy.clear)}</a></p>}
    </form>
  </div>
  <p class="listing-credit">
    {t(['Tĩnh vật · Vang đỏ và hoa lan', 'Still life · Red wine and orchids'])}
    <small>{t(['Ảnh minh họa AI · Heritage iMAP', 'AI-generated illustration · Heritage iMAP'])}</small>
  </p>
</section>

<script>
  import { searchDestinations, type DestinationSearchCandidate } from '../../../lib/destination-search';

  const form = document.querySelector<HTMLFormElement>('[data-listing-search]');
  const input = form?.querySelector<HTMLInputElement>('input[type="search"]');
  const list = form?.querySelector<HTMLUListElement>('.listing-suggestions');
  if (form && input && list) {
    const provinces: DestinationSearchCandidate[] = JSON.parse(form.dataset.provinces ?? '[]');
    const update = () => {
      const matches = searchDestinations(provinces, input.value);
      list.replaceChildren(...matches.map(province => {
        const item = document.createElement('li');
        const option = document.createElement('button');
        option.type = 'button';
        option.textContent = form.dataset.lang === 'en' ? province.nameEn : province.nameVi;
        option.addEventListener('click', () => {
          input.value = option.textContent ?? '';
          form.requestSubmit();
        });
        item.append(option);
        return item;
      }));
      list.hidden = matches.length === 0;
    };
    input.addEventListener('input', update);
    input.addEventListener('focus', update);
    form.addEventListener('focusout', event => {
      if (!(event.relatedTarget instanceof Node) || !form.contains(event.relatedTarget)) list.hidden = true;
    });
    form.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !list.hidden) {
        event.preventDefault();
        if (document.activeElement !== input) input.focus();
        list.hidden = true;
      }
      if (event.key === 'ArrowDown' && event.target === input && !list.hidden) {
        event.preventDefault();
        list.querySelector('button')?.focus();
      }
    });
  }
</script>

<style>
  .listing-hero {
    --listing-inset: 10%;
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: clamp(600px, 45vw, 670px);
    padding: 64px var(--listing-inset) 138px;
    color: #fff;
    background: #310e18;
  }
  .listing-artwork {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 61% 51%;
  }
  .listing-intro { width: min(100%, 450px); }
  .listing-hero h1 {
    margin-bottom: clamp(24px, 2.5vw, 36px);
    font: inherit;
    text-wrap: balance;
    text-shadow: 0 1px 12px #200f0a55;
  }
  .listing-credit {
    position: absolute;
    inset: auto var(--listing-inset) 38px;
    width: fit-content;
    font-size: 13px;
    line-height: 1.55;
    text-shadow: 0 1px 5px #150a05c0;
    pointer-events: none;
  }
  .listing-credit small { display: block; margin-top: 2px; font-size: 11px; }
  form { position: relative; z-index: 1; }
  .listing-search-box {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: center;
    min-height: 62px;
    padding: 6px 14px 6px 3px;
    border: 1px solid #dfd9d2;
    border-radius: 8px;
    background: var(--national-white);
    color: var(--n-ink);
  }
  button[type="submit"] {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    cursor: pointer;
  }
  button[type="submit"]:hover { background: var(--national-ivory); }
  button[type="submit"]:focus-visible { outline-offset: -3px; }
  input[type="search"] {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding-inline: 6px 0;
    border: 0;
    background: transparent;
    color: var(--n-ink);
    font: 400 16px/1.4 var(--n-sans);
  }
  input[type="search"]::placeholder { color: #65656c; }
  input[type="search"]:focus-visible { outline: 2px solid var(--national-petrol); outline-offset: 0; border-radius: 3px; }
  .listing-suggestions { position: absolute; top: 100%; inset-inline: 0; max-height: 210px; overflow-y: auto; margin: 4px 0 0; padding: 4px; list-style: none; border: 1px solid var(--national-control-border); border-radius: 7px; background: var(--national-white); color: var(--n-ink); box-shadow: var(--national-control-elevation); }
  .listing-suggestions :global(button) { display: block; width: 100%; min-height: 42px; border: 0; border-radius: 3px; padding-inline: 10px; text-align: start; background: transparent; cursor: pointer; font: inherit; font-size: 14px; }
  .listing-suggestions :global(button:hover), .listing-suggestions :global(button:focus-visible) { background: var(--national-ivory); outline-offset: -2px; }
  #listing-search-error { width: fit-content; padding: 6px 9px; margin-top: 7px; border-radius: 4px; background: #28170edb; font-size: 13px; }
  #listing-search-error a { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 760px) {
    .listing-hero { --listing-inset: clamp(24px, 7vw, 48px); align-items: start; min-height: 530px; padding-block: 110px 100px; }
    .listing-artwork { object-position: 77% 50%; }
    .listing-hero::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset: 0;
      background: linear-gradient(180deg, #240b146b, #240b1462 28%, transparent 56%, transparent 73%, #240b14d9);
      pointer-events: none;
    }
    .listing-credit { bottom: 23px; }
  }

  @media (max-width: 480px) {
    .listing-hero { padding-block-start: 62px; }
    .listing-search-box { grid-template-columns: 44px minmax(0, 1fr); padding-inline: 2px 8px; }
    input[type="search"] { padding-inline-start: 4px; }
    input[type="search"]::placeholder { font-size: 14px; }
  }
</style>
