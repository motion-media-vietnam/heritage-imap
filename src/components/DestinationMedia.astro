---
import type { DestinationMedia } from '../lib/destination-media';
import { gallerySupportIndices, featuredYouTubeEmbedUrl } from '../lib/destination-media';
interface Props { media: DestinationMedia; title: string }
const { media, title } = Astro.props;
const embedUrl = media.type === 'video' && media.source === 'youtube' ? featuredYouTubeEmbedUrl(media.videoUrl) : undefined;
const images = media.type === 'gallery' ? media.images : [];
const first = images[0];
---
{media.type === 'video' && (embedUrl || media.source === 'file') ? <>
  <div class="destination-video" data-destination-video data-destination-media="video">
    {embedUrl ? <iframe src={embedUrl} width="960" height="540" loading="lazy"
      title={`Video do khách hàng cung cấp · ${title}`}
      referrerpolicy="strict-origin-when-cross-origin"
      allow="autoplay; encrypted-media; fullscreen; picture-in-picture; web-share" allowfullscreen></iframe>
    : <video src={media.videoUrl} poster={media.poster} width="1920" height="1080" controls playsinline preload="none" aria-label={`Video ${title}`}>
      Trình duyệt chưa hỗ trợ video này. <a href={media.videoUrl}>Mở tệp video gốc</a>
    </video>}
  </div>
  {embedUrl && <p class="video-fallback"><a href={media.videoUrl} target="_blank" rel="noopener noreferrer">Xem video trên YouTube ↗</a></p>}
</> : media.type === 'gallery' && first ?
  <div class="destination-video destination-gallery" data-destination-video data-destination-media="gallery"
    data-gallery-images={JSON.stringify(images)} data-gallery-index="0" role="region" aria-roledescription="thư viện ảnh" aria-label={`Ảnh ${title}`}>
    <div class:list={['gallery-layout', { 'gallery-layout-single': images.length === 1 }]}>
      <button type="button" class="gallery-feature" data-gallery-enlarge aria-label={`Phóng to ảnh: ${first.alt}`}>
        <img data-gallery-feature src={first.src} srcset={first.srcSet} sizes="(max-width: 960px) calc(100vw - 32px), 60vw"
          alt={first.alt} width={first.width} height={first.height} loading="lazy" decoding="async" />
      </button>
      {images.length > 1 && <div class="gallery-supports">
        {gallerySupportIndices(0, images.length).map((index, slot) => <button type="button" data-gallery-support={slot} data-gallery-select={index} aria-label={`Chọn ảnh ${index + 1}: ${images[index]!.alt}`}>
          <img src={images[index]!.thumbnailSrc ?? images[index]!.src} alt={images[index]!.alt}
            width={images[index]!.width} height={images[index]!.height} loading="lazy" decoding="async" />
        </button>)}
      </div>}
    </div>
    <div class="gallery-navigation">
      <button type="button" data-gallery-step="-1" aria-label="Ảnh trước" disabled={images.length < 2}>←</button>
      <span data-gallery-counter role="status" aria-live="polite" aria-atomic="true">1 / {images.length}</span>
      <button type="button" data-gallery-step="1" aria-label="Ảnh tiếp theo" disabled={images.length < 2}>→</button>
      <button type="button" class="gallery-expand" data-gallery-enlarge aria-label="Phóng to ảnh gốc" aria-haspopup="dialog" title="Phóng to ảnh gốc">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5M3 3l6 6m12-6-6 6M3 21l6-6m12 6-6-6" />
        </svg>
      </button>
    </div>
    <dialog class="gallery-dialog" data-gallery-dialog aria-label={`Ảnh phóng to · ${title}`}>
      <div class="gallery-dialog-toolbar"><span>Ảnh · {title}</span><button type="button" data-gallery-close aria-label="Đóng ảnh phóng to">×</button></div>
      <div class="gallery-dialog-image"><img data-gallery-full alt={first.alt} width={first.width} height={first.height} decoding="async" /></div>
      <div class="gallery-dialog-navigation">
        <button type="button" data-gallery-step="-1" aria-label="Ảnh trước" disabled={images.length < 2}>←</button>
        <span data-gallery-counter role="status" aria-live="polite" aria-atomic="true">1 / {images.length}</span>
        <button type="button" data-gallery-step="1" aria-label="Ảnh tiếp theo" disabled={images.length < 2}>→</button>
      </div>
    </dialog>
  </div>
: <div class="destination-video video-placeholder" data-destination-video data-destination-media={media.type}>
    <div><strong>{media.type === 'gallery' ? 'Ảnh đang được cập nhật' : 'Video đang được cập nhật'}</strong><small>Chưa có ảnh hoặc video được duyệt · Khung chờ nội dung</small></div>
  </div>}
<script>import '../scripts/destination-media';</script>
<style is:global>
  /* Media-only rules: the approved parent frame, desktop ordering and sheet stay intact. */
  .imap-prototype .destination-gallery { aspect-ratio: auto; background: transparent; isolation: isolate; }
  .imap-prototype .gallery-layout { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 6px; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 14px; }
  .imap-prototype .gallery-layout-single { grid-template-columns: minmax(0, 1fr); }
  .imap-prototype .destination-gallery button { border: 0; padding: 0; background: transparent; color: #203A5E; cursor: pointer; font: inherit; }
  .imap-prototype .gallery-feature { position: relative; min-width: 0; min-height: 0; overflow: hidden; }
  .imap-prototype .destination-gallery img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--gallery-object-position, 50% 40%); }
  .imap-prototype .gallery-supports { display: grid; grid-auto-rows: minmax(0, 1fr); gap: 6px; min-height: 0; }
  .imap-prototype .gallery-supports button { min-width: 0; min-height: 0; overflow: hidden; }
  .imap-prototype .gallery-navigation { display: grid; grid-template-columns: 44px minmax(64px, auto) 44px 44px; align-items: center; justify-content: end; gap: 4px; min-height: 48px; padding-inline: 4px; }
  .imap-prototype .gallery-navigation button { display: grid; place-items: center; border-radius: 8px; }
  .imap-prototype .gallery-navigation button:not(:disabled):hover { background: #F7F8F7; }
  .imap-prototype .gallery-navigation [data-gallery-counter] { text-align: center; }
  .imap-prototype .destination-gallery :is([data-gallery-step], [data-gallery-close], .gallery-expand) { min-width: 44px; min-height: 44px; }
  .imap-prototype .destination-gallery button:disabled { opacity: .35; cursor: default; }
  .imap-prototype .destination-gallery button:focus-visible { outline: 2px solid #203A5E; outline-offset: -3px; }
  .imap-prototype [data-gallery-counter] { font-size: 11px; font-variant-numeric: tabular-nums; }
  .imap-prototype .gallery-dialog { width: min(1100px, calc(100vw - 24px)); max-width: calc(100vw - 24px); height: min(850px, calc(100dvh - 24px)); max-height: calc(100dvh - 24px); margin: auto; padding: 0; border: 1px solid #E5E7E5; border-radius: 12px; background: #fff; color: #242724; overscroll-behavior: contain; }
  .imap-prototype .gallery-dialog[open] { display: flex; flex-direction: column; }
  .imap-prototype .gallery-dialog::backdrop { background: #102135bf; }
  .imap-prototype .gallery-dialog-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-inline: max(12px, env(safe-area-inset-left)) max(12px, env(safe-area-inset-right)); flex-shrink: 0; font-size: 12px; }
  .imap-prototype .gallery-dialog-image { flex: 1; min-height: 0; overflow: hidden; }
  .imap-prototype .gallery-dialog-image img { object-fit: contain; object-position: center; }
  .imap-prototype .gallery-dialog-navigation { display: flex; align-items: center; justify-content: center; gap: 12px; padding-bottom: env(safe-area-inset-bottom); flex-shrink: 0; }
  @media (max-width: 960px) {
    .imap-prototype .gallery-layout { grid-template-columns: minmax(0, 1fr); aspect-ratio: 4 / 3; }
    .imap-prototype .gallery-navigation { justify-content: center; }
    .imap-prototype .gallery-supports { display: none; }
    .imap-prototype .gallery-feature, .imap-prototype .gallery-dialog-image { touch-action: pan-y pinch-zoom; }
  }
</style>
