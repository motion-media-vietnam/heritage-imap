---
import PlaceDetail from '../../components/destination/PlaceDetail.astro';
import HeritageLauncher from '../../components/HeritageLauncher.astro';
import { hanoi } from '../../data/destinations/hanoi/config';
import { hanoiPlacePaths } from '../../destinations/hanoi/place-paths';
import { legacyHanoiRoutes } from '../../destinations/hanoi/routes';

export const getStaticPaths = hanoiPlacePaths;
const { place } = Astro.props;
---
<PlaceDetail hub={hanoi} homePath={legacyHanoiRoutes.home} place={place}>
  <HeritageLauncher slot="assistant" />
</PlaceDetail>
