---
import Photo from './Photo.astro';
import Icon from '../shared/Icon.astro';
import { cuisineCopy, cuisineHref } from '../../data/national/cuisine';
import { photos } from '../../data/national/assets';
import { translate, ui, type Language } from '../../data/national/locale';

interface Props { lang: Language }
const { lang } = Astro.props;
const t = (value: Parameters<typeof translate>[0]) => translate(value, lang);
const cuisine = cuisineHref(lang);
---
<section id="taste" class="n-taste n-section" aria-labelledby="taste-title">
  <div class="n-shell n-taste-shell">
    <header class="n-section-top n-taste-heading">
      <div>
        <p class="n-eyebrow"><span>05</span> — TASTE OF VIETNAM</p>
        <h2 id="taste-title">{t(ui.tasteIntro)}</h2>
      </div>
      <p>{t(cuisineCopy.intro)}</p>
    </header>
    <div class="n-taste-spread">
      <article class="n-taste-editorial">
        <a class="n-taste-story" href={cuisine + '#chuyen-am-thuc'} aria-labelledby="taste-story-title taste-story-cta">
          <figure class="n-taste-feature">
            <Photo photo={photos.taste} {lang} sizes="(max-width: 700px) 94vw, (max-width: 1360px) 55vw, 730px" />
            <figcaption class="n-photo-credit">{t(ui.imagery)}</figcaption>
          </figure>
          <div class="n-taste-story-copy">
            <div>
              <p class="n-eyebrow">{t(['Câu chuyện ẩm thực', 'Culinary story'])}</p>
              <h3 id="taste-story-title">{t(['Hành trình của gia vị', 'The journey of spice'])}</h3>
              <p class="n-taste-draft">{t(['Tựa bài minh họa', 'Working title'])}</p>
            </div>
            <span class="n-taste-cta" id="taste-story-cta">{t(cuisineCopy.read)} <Icon name="arrow" size={16} /></span>
          </div>
        </a>
      </article>
      <article class="n-taste-restaurants">
        <a class="n-taste-guide" href={cuisine + '#nha-hang'} aria-labelledby="taste-guide-title taste-guide-cta">
          <img src="/images/hanoi-rooftop-bar.jpg" alt={t(['Không gian bàn ăn ngoài trời với giàn hoa trong ánh chiều Hà Nội', 'An outdoor dining terrace with flowers in Hanoi’s evening light'])} width="800" height="533" loading="lazy" decoding="async" />
          <div class="n-taste-guide-copy">
            <p class="n-eyebrow">{t(cuisineCopy.recommends)}</p>
            <h3 id="taste-guide-title">{t(['Những nhà hàng tốt nhất Việt Nam', 'Vietnam’s best restaurants'])}</h3>
            <p class="n-taste-guide-teaser">{t(['Những địa chỉ ẩm thực đáng trải nghiệm được Heritage tuyển chọn.', 'Memorable places to eat, selected by Heritage.'])}</p>
            <span class="n-taste-cta n-taste-cta-button" id="taste-guide-cta">{t(cuisineCopy.find)} <Icon name="arrow" size={16} /></span>
          </div>
        </a>
        <p class="n-photo-credit">{t(ui.mixedImagery)}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .n-taste { background: #fffdfa; }
  .n-taste-shell { max-width: 1260px; }
  .n-taste-heading { gap: 24px; margin-bottom: clamp(22px, 3vw, 38px); }
  .n-taste-heading h2 { max-width: 25ch; margin-bottom: 0; }
  .n-taste-heading > p { max-width: 33ch; font-size: 14px; line-height: 1.65; }
  .n-taste-spread { display: grid; grid-template-columns: minmax(0, 1.52fr) minmax(0, 1fr); gap: clamp(20px, 3.3vw, 46px); }
  .n-taste-editorial, .n-taste-restaurants { min-width: 0; }
  .n-taste-story { display: block; }
  .n-taste-feature :global(img) { width: 100%; aspect-ratio: 1.46; height: auto; object-fit: cover; object-position: 50% 54%; }
  .n-taste .n-photo-credit { margin-top: 8px; }
  .n-taste-story-copy {
    display: flex; align-items: end; justify-content: space-between; gap: 10px 18px; flex-wrap: wrap;
    border-top: 1px solid #dfd0b5; margin-top: 12px; padding-top: 15px;
  }
  .n-taste :is(.n-taste-story-copy, .n-taste-guide-copy) h3 { font-family: var(--n-serif); letter-spacing: -.034em; }
  .n-taste-story-copy h3 { font-size: clamp(29px, 3.7vw, 53px); margin: 6px 0 3px; }
  .n-taste-draft { font-size: 11px; color: #6e6658; }
  .n-taste-restaurants { display: flex; flex-direction: column; padding-top: clamp(19px, 2.4vw, 34px); }
  .n-taste-guide {
    position: relative; isolation: isolate; flex: 1; display: flex; align-items: end;
    min-height: clamp(430px, 39vw, 565px); padding-block: 150px clamp(16px, 2.5vw, 34px);
    background: #534c43;
  }
  .n-taste-guide > img { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 58% 50%; }
  .n-taste-guide-copy {
    width: min(84%, 400px); margin-inline: auto; padding: clamp(16px, 2vw, 27px);
    border: 1px solid #eee0c8; background: rgba(255, 251, 242, .91);
    -webkit-backdrop-filter: blur(9px); backdrop-filter: blur(9px);
  }
  .n-taste-guide-copy h3 { font-size: clamp(23px, 2.55vw, 36px); margin: 8px 0 10px; }
  .n-taste-guide-teaser { color: #4e4a41; font-size: 13px; line-height: 1.55; margin-bottom: 13px; max-width: 32ch; }
  .n-taste-cta {
    display: inline-flex; align-items: center; gap: 12px; min-height: 44px; width: fit-content;
    color: var(--national-petrol-deep); font: 600 10px/1.35 var(--n-sans); letter-spacing: .1em;
    text-transform: uppercase; text-underline-offset: 4px;
  }
  .n-taste-cta-button { padding: 7px 12px; border: 1px solid #a88b5d80; border-radius: var(--national-control-radius); background: var(--national-control-surface); }
  .n-taste-story:hover .n-taste-cta, .n-taste-guide:hover .n-taste-cta { text-decoration: underline; }
  @media (min-width: 701px) and (max-width: 900px) {
    .n-taste-guide { min-height: 420px; padding-top: 130px; }
    .n-taste-guide-copy { width: 87%; padding: 15px; }
  }
  @media (max-width: 700px) {
    .n-taste-heading { gap: 10px; }
    .n-taste-spread { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .n-taste-restaurants { padding-top: 0; }
    .n-taste-guide { min-height: clamp(398px, 63vw, 480px); }
    .n-taste-guide-copy { width: min(83%, 390px); }
  }
  @media (max-width: 520px) {
    .n-taste { padding-block: 49px; }
    .n-taste-feature :global(img) { aspect-ratio: 1.2; }
    .n-taste-story-copy { row-gap: 1px; }
    .n-taste-story-copy h3 { font-size: clamp(25px, 7.2vw, 29px); }
    .n-taste-guide { min-height: 395px; padding-top: 135px; }
    .n-taste-guide-copy { width: 84%; }
  }
</style>
